<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>RecDiffy.Samples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SamplesFolder)*.cs" Link="Samples/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecDiffy.RulePacks.Trading" Version="$(RecDiffyVersion)" />
    <PackageReference Include="RecDiffy.IO" Version="$(RecDiffyVersion)" />
    <PackageReference Include="RecDiffy.Excel" Version="$(RecDiffyVersion)" />
  </ItemGroup>

</Project>
