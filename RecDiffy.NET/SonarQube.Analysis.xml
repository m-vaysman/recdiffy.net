<?xml version="1.0" encoding="utf-8" ?>
<!--
  Shared SonarScanner for .NET analysis settings (loaded via /s:).
  Do not put tokens or host URLs here — those come from GitHub secrets.
  sonar-project.properties is NOT read by the .NET scanner.
-->
<SonarQubeAnalysisProperties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                             xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
  <!-- Docs, fixtures, logos, and reference workbooks are not product source. -->
  <Property Name="sonar.exclusions">**/docs/**,**/resources/**,**/test-data/**,**/*.xlsx</Property>
  <!-- Samples / benchmarks / AOT host / demo apps / tests should not drag down coverage. -->
  <Property Name="sonar.coverage.exclusions">**/RecDiffy.Samples/**,**/RecDiffy.Benchmarks/**,**/RecDiffy.AotHost/**,**/RecDiffy.PublicDataDemo/**,**/RecDiffy.BrowserDemo/**,**/RecDiffy.ThirteenFDemo/**,**/RecDiffy.Tests/**,**/RecDiffy.Excel.Tests/**,**/docs/**</Property>
  <Property Name="sonar.cpd.exclusions">**/RecDiffy.Samples/**,**/RecDiffy.Benchmarks/**</Property>
  <!--
    Web:S7039 ('unsafe-inline' in a Content-Security-Policy), for the browser demo's page only. Blazor WebAssembly on
    .NET 10 writes the import map into an inline <script> at publish time and sets inline styles, so script-src and
    style-src need 'unsafe-inline' unless the publish step computes hashes. The privacy promise rests on
    connect-src 'self', which is unchanged.
  -->
  <!--
    csharpsquid:S5693 (content length of HTTP requests), for the browser demo's page only: OpenReadStream reads a file
    the visitor picked, inside the browser tab. No HTTP request is made and there is no server to protect.
    Sonar does not honor #pragma in .razor files, so the exception lives here.
  -->
  <Property Name="sonar.issue.ignore.multicriteria">csp,upload</Property>
  <Property Name="sonar.issue.ignore.multicriteria.csp.ruleKey">Web:S7039</Property>
  <Property Name="sonar.issue.ignore.multicriteria.csp.resourceKey">**/RecDiffy.BrowserDemo/wwwroot/index.html</Property>
  <Property Name="sonar.issue.ignore.multicriteria.upload.ruleKey">csharpsquid:S5693</Property>
  <Property Name="sonar.issue.ignore.multicriteria.upload.resourceKey">**/RecDiffy.BrowserDemo/Pages/Home.razor</Property>
</SonarQubeAnalysisProperties>
