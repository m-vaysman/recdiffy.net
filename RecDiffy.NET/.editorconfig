root = true

[*.cs]
# Possible multiple enumeration of IEnumerable. Disabled by default in the SDK analyzers.
dotnet_diagnostic.CA1851.severity = warning

# Culture-sensitive calls (ToString, Parse, string.Format) must pass an explicit IFormatProvider, normally CultureInfo.InvariantCulture.
dotnet_diagnostic.CA1305.severity = warning

# An interpolated hole such as {row} formats with the current culture, so an Excel formula, a cell reference or
# other machine-readable text can change with the machine. Production code spells the call: {row.ToInvariant()}.
# See RecDiffy.InvariantFormatting. Test projects reset it to the analyzer's default in their own .editorconfig.
dotnet_diagnostic.MA0076.severity = error

# String == and != are ordinal; string.Equals would break the switch expressions and patterns this repo uses.
dotnet_diagnostic.MA0006.severity = none

# Related types stay together (model, profile, workbook). One type per file fights that layout.
dotnet_diagnostic.MA0048.severity = none

# Sheet builders are linear; a 60-line cap would split them into noise.
dotnet_diagnostic.MA0051.severity = none

# `x is false` is a deliberate pattern-matching style here, not a boolean-literal comparison.
dotnet_diagnostic.RCS1049.severity = none

# Naming every literal argument adds noise; name arguments only where the call site needs it.
dotnet_diagnostic.MA0003.severity = none

# JsonElement array and object enumerators are disposable structs whose Dispose is a no-op, and LINQ consumes them.
[src/RecDiffy/Profile/ProfileParser.cs]
dotnet_diagnostic.IDISP004.severity = none
