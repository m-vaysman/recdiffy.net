<Project>
  <PropertyGroup>
    <Authors>Michael Vaysman</Authors>
    <Title>Reconciliation: RecDiffy.NET</Title>
    <Description>Reconciliation for .NET: a general-purpose library that matches two datasets, diffs their fields and explains every difference.</Description>
    <PackageReleaseNotes>Breaking: Run, RunAsync and BuildSideBySide now return read-only interfaces, and the concrete result classes are internal. See BREAKING-CHANGES.md: https://github.com/m-vaysman/recdiffy.net/blob/main/RecDiffy.NET/BREAKING-CHANGES.md</PackageReleaseNotes>
    <!-- Searchable terms first: reconciliation, then the synonyms people search for, then the technical ones. -->
    <PackageTags>reconciliation;reconcile;data-reconciliation;matching;diff;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Michael Vaysman</Copyright>
    <RepositoryUrl>https://github.com/m-vaysman/recdiffy.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/m-vaysman/recdiffy.net</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Analyzer-only. PrivateAssets keeps them out of published package dependencies. -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.321">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
