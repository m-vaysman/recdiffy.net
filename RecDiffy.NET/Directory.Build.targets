<Project>
  <!-- Imported after the project sets IsPackable, so tests, benchmarks, and the AOT host stay unpackaged. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>columns-square-icon.jpg</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)resources/logos/columns-square-icon.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
