<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{93716989-77D6-53D7-B64C-1196A26BFF63}</ProjectGuid>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>RecDiffy</RootNamespace>
    <Title>Reconciliation: the RecDiffy.NET engine</Title>
    <Description>Reconciliation for .NET: match two datasets, diff their fields and explain every difference. The engine: profiles, normalization, matching, comparison and results.</Description>
    <PackageTags>reconciliation;reconcile;data-reconciliation;matching;diff;dotnet;data-quality;record-linkage</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <NoWarn>$(NoWarn);MA0002</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecDiffy.Tests" />
    <InternalsVisibleTo Include="RecDiffy.Benchmarks" />
    <InternalsVisibleTo Include="RecDiffy.RulePacks.Trading" />
  </ItemGroup>

</Project>
