@inherits LayoutComponentBase

<main class="page">
    <header class="top">
        <p class="brand"><a href="https://github.com/m-vaysman/recdiffy.net">RecDiffy.NET</a>, a reconciliation engine for .NET</p>
        <h1>Reconcile SEC 13F holdings quarter over quarter</h1>
        <p class="lede">Pick an institutional investment manager, choose any two Form 13F quarters, and see every unchanged position, every share or market-value change, every new holding and every exit.</p>
    </header>

    @Body

    <footer class="foot">
        <p>RecDiffy.NET is open source. <a href="https://www.nuget.org/packages/RecDiffy">NuGet</a> · <a href="https://github.com/m-vaysman/recdiffy.net">Source</a> · SEC EDGAR Form 13F holdings reconciliation</p>
    </footer>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
