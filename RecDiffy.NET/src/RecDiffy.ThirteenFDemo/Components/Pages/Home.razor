    private void OnPriorFilingChanged(ChangeEventArgs e)
    {
        var accession = e.Value?.ToString() ?? "";
        priorFiling = priorFilings.FirstOrDefault(filing => filing.AccessionNumber == accession);
    }

    private void OnCurrentFilingChanged(ChangeEventArgs e)
    {
        var accession = e.Value?.ToString() ?? "";
        currentFiling = currentFilings.FirstOrDefault(filing => filing.AccessionNumber == accession);
    }

    private void SwapQuarters()
    {
        (priorYear, currentYear) = (currentYear, priorYear);
        (priorFilings, currentFilings) = (currentFilings, priorFilings);
        (priorFiling, currentFiling) = (currentFiling, priorFiling);
    }

    private async Task CompareSelectedAsync()
    {
        statusFilter = null;
        currentPage = 1;
        await ExecuteCompareAsync();
    }

    private Task RetryCompareAsync() => ExecuteCompareAsync();

    private async Task SetFilterAsync(HoldingStatus? nextFilter)
    {
        var effective = statusFilter == nextFilter && nextFilter is not null ? null : nextFilter;
        statusFilter = effective;
        currentPage = 1;
        await ExecuteCompareAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            || !HoldingsPresentation.SupportedPageSizes.Contains(parsed))
        {
            return;
        }

        pageSize = parsed;
        currentPage = 1;
        await ExecuteCompareAsync();
    }

    private async Task GoToPageAsync(int targetPage)
    {
        if (targetPage < 1 || targetPage == currentPage)
        {
            return;
        }

        currentPage = targetPage;
        await ExecuteCompareAsync();
    }

    private async Task ExecuteCompareAsync()
    {
        if (selectedManager is not { } manager || priorFiling is not { } prior || currentFiling is not { } current)
        {
            return;
        }

        var token = _compareGate.Next();
        comparing = true;
        compareError = null;

        try
        {
            var result = await ThirteenF.CompareAsync(
                manager.Cik,
                prior,
                current,
                statusFilter,
                currentPage,
                pageSize,
                token);

            if (token.IsCancellationRequested)
            {
                return;
            }

            comparison = result;
            currentPage = result.Page;
            comparing = false;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or IOException or InvalidDataException or InvalidOperationException)
        {
            comparing = false;
            compareError = HoldingsPresentation.FriendlySecError(ex, "comparing 13F holdings");
        }
    }

    private async Task<IReadOnlyList<FilingRef>> FetchFilingsCachedAsync(string cik, int year, CancellationToken ct)
    {
        if (_filingsCache.TryGetValue((cik, year), out var cached))
        {
            return cached;
        }

        var raw = await ThirteenF.GetFilingsAsync(cik, year, ct);
        var ordered = HoldingsPresentation.OrderFilingsNewestFirst(raw);
        if (!ct.IsCancellationRequested)
        {
            _filingsCache[(cik, year)] = ordered;
        }

        return ordered;
    }

    private static int? ParseYear(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var year)
            ? year
            : null;

    private static string FilterName(HoldingStatus status) => status switch
    {
        HoldingStatus.Unchanged => "Unchanged",
        HoldingStatus.Changed => "Changed",
        HoldingStatus.New => "New",
        HoldingStatus.Exited => "Exited",
        _ => status.ToInvariant(),
    };

    public void Dispose()
    {
        _searchGate.Dispose();
        _filingsGate.Dispose();
        _compareGate.Dispose();
    }
}
