      "role": "Economic",
      "scale": 2
    },
    {
      "name": "Price",
      "type": "Decimal",
      "role": "Economic",
      "scale": 6
    },
    {
      "name": "Accrued",
      "type": "Decimal",
      "role": "Economic",
      "scale": 2
    },
    {
      "name": "Fees",
      "type": "Decimal",
      "role": "Economic",
      "scale": 2
    },
    {
      "name": "NetCash",
      "type": "Decimal",
      "role": "Economic",
      "scale": 2
    },
    {
      "name": "Uti",
      "type": "Identifier",
      "role": "Identity"
    },
    {
