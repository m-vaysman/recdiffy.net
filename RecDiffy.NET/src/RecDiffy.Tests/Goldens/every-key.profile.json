{
  "formatVersion": 1,
  "profileId": "every-key",
  "version": "2.3.4",
  "rounding": {
    "midpoint": "AwayFromZero"
  },
  "sources": {
    "left": {
      "rowKey": "Internal_Trade_ID"
    },
    "right": {
      "rowKey": "Cpty_Report_ID"
    }
  },
  "fields": [
    {
      "name": "Counterparty",
      "type": "Identifier",
