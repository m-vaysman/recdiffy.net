{
  "formatVersion": 1,
  "profileId": "trade-recon.sonnet",
  "version": "1.0.0",
  "rulePacks": ["trading@1"],
  "rounding": { "midpoint": "ToEven" },
  "sources": {
    "left": { "rowKey": "Internal_Trade_ID" },
    "right": { "rowKey": "Cpty_Report_ID" }
  },
  "fields": [
    { "name": "Counterparty", "type": "Identifier", "role": "Key" },
    { "name": "Instrument", "type": "Identifier", "role": "Key" },
    { "name": "AssetClass", "type": "Symbol", "role": "Key" },
    { "name": "TradeDate", "type": "Date", "role": "Key" },
    { "name": "Side", "type": "Symbol", "role": "Key" },
    { "name": "Quantity", "type": "Decimal", "scale": 2, "role": "Economic" },
    { "name": "Price", "type": "Decimal", "scale": 6, "role": "Economic" },
    { "name": "SettleDate", "type": "Date", "role": "Economic" },
    { "name": "Currency", "type": "Symbol", "role": "Economic" },
    { "name": "Accrued", "type": "Decimal", "scale": 2, "role": "Economic" },
    { "name": "Coupon", "type": "Decimal", "scale": 6, "role": "Economic" },
    { "name": "Maturity", "type": "Date", "role": "Economic" },
    { "name": "Fees", "type": "Decimal", "scale": 2, "role": "Economic" },
    { "name": "NetCash", "type": "Decimal", "scale": 2, "role": "Economic" },
    { "name": "TradeRef", "type": "Identifier", "role": "Identity" },
    { "name": "EventId", "type": "Identifier", "role": "Lifecycle" },
    { "name": "EventAction", "type": "Symbol", "role": "Lifecycle" },
    { "name": "EventTarget", "type": "Identifier", "role": "Lifecycle" },
    { "name": "PackageRef", "type": "Identifier", "role": "Package" },
    { "name": "LegRole", "type": "Symbol", "role": "Package" }
  ],
  "normalization": {
    "left": {
      "identify": [
        { "rule": "identifier.map", "from": "Counterparty_Code", "to": "Counterparty", "scheme": "party" },
        { "rule": "instrument.resolve", "to": "Instrument", "canonical": ["ISIN", "Ticker"] },
        { "rule": "symbol.map", "from": "Asset_Class", "to": "AssetClass", "passthrough": "true" },
        { "rule": "symbol.map", "from": "Currency", "to": "Currency", "passthrough": "true" },
        { "rule": "tradeRef.classify", "from": "UTI_Exec_ID", "to": "TradeRef", "shared": "lei30", "party": "Counterparty" },
        { "rule": "identifier.map", "from": "Parent_Link_ID", "to": "PackageRef", "scheme": "package" },
        { "rule": "symbol.map", "from": "Leg_Structure", "to": "LegRole", "passthrough": "true" }
      ],
      "parse": [
        { "rule": "date.parse", "from": "Trade_Date", "to": "TradeDate" },
        { "rule": "date.parse", "from": "Settle_Date", "to": "SettleDate" },
        { "rule": "date.parse", "from": "Maturity_Date", "to": "Maturity" },
        { "rule": "decimal.parse", "from": "Clean_Price_Rate", "to": "Price" },
        { "rule": "decimal.parse", "from": "Accrued_Interest", "to": "Accrued" },
        { "rule": "decimal.parse", "from": "Commission_Fees", "to": "Fees" },
        { "rule": "decimal.parse", "from": "Net_Settlement_Amount", "to": "NetCash" },
        { "rule": "decimal.parse", "from": "Coupon_Rate", "to": "Coupon" }
      ],
      "derive": [
        { "rule": "side.resolve", "code": "Side", "quantity": "Quantity_Notional" },
        { "rule": "quantity.absolute", "from": "Quantity_Notional", "to": "Quantity" }
      ],
      "validate": [
        { "rule": "required.present", "fields": ["Counterparty", "Quantity", "Price", "TradeDate", "Side", "NetCash"] },
        { "rule": "side.determined" }
      ]
    },
    "right": {
      "identify": [
        { "rule": "party.resolveLei", "from": "Counterparty_LEI", "to": "Counterparty" },
        { "rule": "party.resolveAlias", "from": "Reporting_Counterparty_Name", "to": "Counterparty" },
        { "rule": "instrument.resolve", "to": "Instrument", "idColumn": "Primary_Security_ID", "schemeColumn": "Security_ID_Source" },
        { "rule": "symbol.map", "from": "Product_Type", "to": "AssetClass", "map": { "GOVT_BOND": "Bond", "CORP_BOND": "Bond", "CASH_EQ": "Equity", "FX_FWD": "Forward", "IRS": "Swap" } },
        { "rule": "symbol.map", "from": "Trade_Ccy", "to": "Currency", "passthrough": "true" },
        { "rule": "tradeRef.classify", "from": "Shared_Market_Exec_Ref", "to": "TradeRef", "shared": "lei30", "party": "Counterparty" },
        { "rule": "symbol.map", "from": "Trans_Lifecycle_Action", "to": "EventAction", "passthrough": "true" },
        { "rule": "identifier.map", "from": "Cpty_Report_ID", "to": "EventId", "scheme": "event", "scopeFrom": "Counterparty" },
        { "rule": "identifier.map", "from": "Cancels_Prior_Report_ID", "to": "EventTarget", "scheme": "event", "scopeFrom": "Counterparty" }
      ],
      "parse": [
        { "rule": "date.parse", "from": "Trade_Date", "to": "TradeDate", "formatBy": "Counterparty" },
        { "rule": "date.parse", "from": "Value_Settle_Date", "to": "SettleDate", "formatBy": "Counterparty" },
        { "rule": "date.parse", "from": "Maturity", "to": "Maturity", "formatBy": "Counterparty" },
        { "rule": "decimal.parse", "from": "Exec_Price_Rate", "to": "Price", "when": { "field": "Price_Quote_Convention", "notEquals": "32NDS_UST" } },
        { "rule": "price.from32nds", "from": "Exec_Price_Rate", "to": "Price", "when": { "field": "Price_Quote_Convention", "equals": "32NDS_UST" } },
        { "rule": "decimal.parse", "from": "Reported_Accrued_Int", "to": "Accrued" },
        { "rule": "decimal.parse", "from": "Net_Cash_Amount", "to": "NetCash" },
        { "rule": "decimal.parse", "from": "Coupon", "to": "Coupon" }
      ],
      "derive": [
        { "rule": "side.resolve", "code": "Dir_Ind", "quantity": "Reported_Qty_Notional", "invertWhen": "DEALER_BILATERAL_VIEW" },
        { "rule": "quantity.absolute", "from": "Reported_Qty_Notional" },
        { "rule": "price.dirtyToClean", "when": { "field": "Price_Quote_Convention", "equals": "DIRTY_PCT_PAR" } },
        { "rule": "fees.inferFromNet" }
      ],
      "validate": [
        { "rule": "required.present", "fields": ["Counterparty", "Quantity", "Price", "TradeDate", "Side", "NetCash"] },
        { "rule": "side.determined" }
      ]
    }
  },
  "consolidation": {
    "right": { "lifecycle": { "rule": "lifecycle.newCancCorr", "corrTarget": "CANC" } },
    "left": {
      "packages": [
        {
          "rule": "package.byLink",
          "link": "Parent_Link_ID",
          "role": "Leg_Structure",
          "requiredRoles": ["LEG_1_PAY", "LEG_2_RECEIVE"],
          "aggregate": {
            "Quantity": "Same",
            "Price": "FromRole(LEG_1_PAY)",
            "Side": "FromRole(LEG_1_PAY)",
            "NetCash": "DifferenceByRole(LEG_1_PAY,LEG_2_RECEIVE)",
            "Accrued": "DifferenceByRole(LEG_1_PAY,LEG_2_RECEIVE)"
          }
        }
      ]
    }
  },
  "paths": [
    {
      "id": "trade",
      "route": { "rule": "route.all" },
      "passes": [
        { "id": "P1", "pass": "match.sharedRef" },
        { "id": "P2", "pass": "match.naturalKey", "key": ["Counterparty", "Instrument", "AssetClass", "TradeDate", "Side", "Quantity"], "veto": "TradeRef" },
        { "id": "P3", "pass": "match.groupSum", "many": "left", "block": ["Counterparty", "Instrument", "TradeDate", "Side", "Price"], "conserve": ["Quantity", "NetCash"], "veto": "TradeRef" },
        { "id": "P4", "pass": "match.reducedKey", "key": ["Counterparty", "Instrument", "TradeDate", "Side"], "veto": "TradeRef" }
      ],
      "diff": {
        "default": "exact",
        "fields": {
          "Accrued": { "tolerance": { "absolute": 1.25 }, "applicableWhen": { "field": "AssetClass", "in": ["Bond", "Swap"] } },
          "Price": { "tolerance": { "absolute": 0.0001, "when": { "field": "AssetClass", "equals": "Forward" } } },
          "Fees": { "tolerance": { "absolute": 0.05 }, "applicableWhen": { "field": "AssetClass", "in": ["Bond", "Equity", "Forward"] } },
          "NetCash": { "tolerance": { "attributed": "trading.netCash" } }
        }
      }
    }
  ]
}
