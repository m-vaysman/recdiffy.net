<Window x:Class="RecDiffy.ExcelAddIn.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecDiffy.ExcelAddIn.ViewModels;assembly=RecDiffy.ExcelAddIn.ViewModels"
        xmlns:views="clr-namespace:RecDiffy.ExcelAddIn.Views"
        Title="RecDiffy · Reconcile datasets"
        Icon="/RecDiffy.ExcelAddIn;component/Resources/RecDiffy.ico"
        Width="960" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource TextBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RecDiffy.ExcelAddIn;component/Themes/Shell.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="SidePanel">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Heading}" />
          <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Alias}" Content="Alias (optional)" />
          <TextBox x:Name="Alias" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding Side, StringFormat='{}{0} alias'}" />
          <Label Style="{StaticResource FieldLabel}" Content="Source" />
          <WrapPanel>
            <Button Content="Excel file…" Command="{Binding ChooseExcelDataCommand}" Margin="0,0,8,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Choose an Excel file for the {0} data'}" />
            <Button Content="Open workbook…" Command="{Binding ChooseOpenWorkbookDataCommand}" Margin="0,0,8,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Select the {0} data in an open workbook'}" />
            <Button Content="CSV file…" Command="{Binding ChooseCsvFileCommand}" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Choose a CSV file for the {0} data'}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Summary}" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Foreground="{StaticResource BreakBrush}" Text="{Binding Problem}" />
          <StackPanel Visibility="{Binding IsCsv, Converter={StaticResource VisibleWhenTrue}}">
            <CheckBox Margin="0,12,0,0" Content="The first row holds the column names" IsChecked="{Binding CsvHasHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Delimiter}" Content="Delimiter" />
              <ComboBox x:Name="Delimiter" Grid.Row="1" ItemsSource="{x:Static vm:DelimiterChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvDelimiter}" />
              <Label Grid.Column="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Encoding}" Content="Encoding" />
              <ComboBox x:Name="Encoding" Grid.Row="1" Grid.Column="2" ItemsSource="{x:Static vm:EncodingChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvEncoding}" />
              <Label Grid.Row="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Quote}" Content="Quote" />
              <ComboBox x:Name="Quote" Grid.Row="3" ItemsSource="{x:Static vm:QuoteChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvQuote}" />
              <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Escape}" Content="Quote inside a field" />
              <ComboBox x:Name="Escape" Grid.Row="3" Grid.Column="2" ItemsSource="{x:Static vm:EscapeChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvEscape}" />
            </Grid>
          </StackPanel>
          <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Culture}" Content="Culture for text values" />
          <ComboBox x:Name="Culture" DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                    ItemsSource="{Binding DataContext.Sources.Cultures, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding Culture}"
                    AutomationProperties.Name="{Binding Side, StringFormat='{}{0} culture'}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="PreviewPanel">
        <StackPanel Margin="0,0,0,16">
          <TextBlock FontWeight="Medium" Text="{Binding Heading}" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,6" Text="{Binding PreviewCaption}" />
          <DataGrid views:PreviewGrid.Preview="{Binding Preview}"
                    Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.Name="{Binding Side, StringFormat='{}{0} sample rows'}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,20,24,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource TitleText}" Text="Reconcile datasets" />
        <Border Style="{StaticResource Pill}">
          <TextBlock FontSize="12" Text="Preview" />
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource SecondaryText}" Text="RecDiffy.NET · Excel add-in" />
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.Name="Reconciliation">
      <TabItem Header="Sources">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentControl Content="{Binding Sources.Left}" ContentTemplate="{StaticResource SidePanel}" Focusable="False" />
              <ContentControl Grid.Column="2" Content="{Binding Sources.Right}" ContentTemplate="{StaticResource SidePanel}" Focusable="False" />
            </Grid>
            <Border Style="{StaticResource Notice}">
              <TextBlock Style="{StaticResource SecondaryText}"
                         Text="Excel file opens a closed workbook read-only. Open workbook uses one that's already open, including changes not yet saved. Either way, select the data in Excel, including its header row. Rows with no values are left out." />
            </Border>
            <Expander Margin="0,16,0,0" IsExpanded="True">
              <Expander.Header>
                <TextBlock Style="{StaticResource SectionHeading}" Margin="0" Text="Preview sample rows" />
              </Expander.Header>
              <StackPanel>
                <ContentControl Content="{Binding Sources.Left}" ContentTemplate="{StaticResource PreviewPanel}" Focusable="False" />
                <ContentControl Content="{Binding Sources.Right}" ContentTemplate="{StaticResource PreviewPanel}" Focusable="False" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Rules">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Matching and comparison rules aren't available yet." />
        </Border>
      </TabItem>
      <TabItem Header="Results">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Choose your sources and rules, then run the reconciliation." />
        </Border>
      </TabItem>
      <TabItem Header="Settings">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Settings aren't available yet." />
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding Status}"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Review rules →" Command="{Binding ReviewRulesCommand}"
                  Visibility="{Binding ShowsReviewRules, Converter={StaticResource VisibleWhenTrue}}" />
          <Button Style="{StaticResource PrimaryButton}" Content="Run reconciliation" IsEnabled="{Binding CanRun}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="{StaticResource VeilBrush}"
          Visibility="{Binding Sources.IsReading, Converter={StaticResource VisibleWhenTrue}}">
      <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
              Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Sources.ReadingMessage}" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Sources.ReadingProgress, Mode=OneWay}"
                       Foreground="{StaticResource InkBrush}" Background="{StaticResource SoftBrush}" BorderThickness="0" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                     Text="Don't change the workbook until reading finishes. Excel is busy until then." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
