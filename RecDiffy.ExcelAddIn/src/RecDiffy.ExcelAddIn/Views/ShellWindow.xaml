<Window x:Class="RecDiffy.ExcelAddIn.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecDiffy.ExcelAddIn.ViewModels;assembly=RecDiffy.ExcelAddIn.ViewModels"
        xmlns:views="clr-namespace:RecDiffy.ExcelAddIn.Views"
        Title="RecDiffy · Reconcile datasets"
        Icon="/RecDiffy.ExcelAddIn;component/Resources/RecDiffy.ico"
        Width="960" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource TextBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RecDiffy.ExcelAddIn;component/Themes/Shell.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="SidePanel">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Heading}" />
          <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Alias}" Content="Alias (optional)" />
          <TextBox x:Name="Alias" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding Side, StringFormat='{}{0} alias'}" />
          <Label Style="{StaticResource FieldLabel}" Content="Source" />
          <WrapPanel>
            <Button Content="Excel file…" Command="{Binding ChooseExcelDataCommand}" Margin="0,0,8,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Choose an Excel file for the {0} data'}" />
            <Button Content="Open workbook…" Command="{Binding ChooseOpenWorkbookDataCommand}" Margin="0,0,8,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Select the {0} data in an open workbook'}" />
            <Button Content="CSV file…" Command="{Binding ChooseCsvFileCommand}" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding Side, StringFormat='Choose a CSV file for the {0} data'}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Summary}" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Foreground="{StaticResource BreakBrush}" Text="{Binding Problem}" />
          <StackPanel Visibility="{Binding IsCsv, Converter={StaticResource VisibleWhenTrue}}">
            <CheckBox Margin="0,12,0,0" Content="The first row holds the column names" IsChecked="{Binding CsvHasHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Delimiter}" Content="Delimiter" />
              <ComboBox x:Name="Delimiter" Grid.Row="1" ItemsSource="{x:Static vm:DelimiterChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvDelimiter}" />
              <Label Grid.Column="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Encoding}" Content="Encoding" />
              <ComboBox x:Name="Encoding" Grid.Row="1" Grid.Column="2" ItemsSource="{x:Static vm:EncodingChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvEncoding}" />
              <Label Grid.Row="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Quote}" Content="Quote" />
              <ComboBox x:Name="Quote" Grid.Row="3" ItemsSource="{x:Static vm:QuoteChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvQuote}" />
              <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Escape}" Content="Quote inside a field" />
              <ComboBox x:Name="Escape" Grid.Row="3" Grid.Column="2" ItemsSource="{x:Static vm:EscapeChoice.All}" DisplayMemberPath="Label"
                        SelectedItem="{Binding CsvEscape}" />
            </Grid>
          </StackPanel>
          <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Culture}" Content="Culture for text values" />
          <ComboBox x:Name="Culture" DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                    ItemsSource="{Binding DataContext.Sources.Cultures, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding Culture}"
                    AutomationProperties.Name="{Binding Side, StringFormat='{}{0} culture'}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="PreviewPanel">
        <StackPanel Margin="0,0,0,16">
          <TextBlock FontWeight="Medium" Text="{Binding Heading}" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,6" Text="{Binding PreviewCaption}" />
          <DataGrid views:PreviewGrid.Table="{Binding PreviewTable}"
                    Visibility="{Binding HasData, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.Name="{Binding Side, StringFormat='{}{0} sample rows'}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="FieldRow">
        <StackPanel Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Field name" />
            <ComboBox Grid.Column="1" Margin="0,0,8,0" SelectedItem="{Binding LeftColumn}"
                      ItemsSource="{Binding DataContext.LeftColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      AutomationProperties.Name="Left column" />
            <ComboBox Grid.Column="2" Margin="0,0,8,0" SelectedItem="{Binding RightColumn}"
                      ItemsSource="{Binding DataContext.RightColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      AutomationProperties.Name="Right column" />
            <ComboBox Grid.Column="3" Margin="0,0,8,0" ItemsSource="{x:Static vm:TypeChoice.All}" DisplayMemberPath="Label"
                      SelectedValuePath="Type" SelectedValue="{Binding Type}" AutomationProperties.Name="Field type" />
            <ComboBox Grid.Column="4" Margin="0,0,8,0" ItemsSource="{x:Static vm:RoleChoice.All}" DisplayMemberPath="Label"
                      SelectedValuePath="Role" SelectedValue="{Binding Role}" AutomationProperties.Name="Field role" />
            <TextBox Grid.Column="5" Margin="0,0,8,0" Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsDecimal, Converter={StaticResource VisibleWhenTrue}}"
                     ToolTip="Decimal places the values are rounded to before they're compared" AutomationProperties.Name="Decimal places" />
            <TextBox Grid.Column="5" Margin="0,0,8,0" Text="{Binding DateFormatsText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsDate, Converter={StaticResource VisibleWhenTrue}}"
                     ToolTip="Formats for dates written as text, such as dd.MM.yyyy. Separate several with ;"
                     AutomationProperties.Name="Date formats" />
            <Button Grid.Column="6" Style="{StaticResource SmallButton}" Content="✕" Command="{Binding RemoveCommand}"
                    ToolTip="Remove this field" AutomationProperties.Name="Remove field" />
          </Grid>
          <TextBlock Style="{StaticResource Problem}" Text="{Binding Problem}"
                     Visibility="{Binding Problem, Converter={StaticResource VisibleWhenText}}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="PassRow">
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BlockHeading}" Text="{Binding Title}" />
              <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="✕" Command="{Binding RemoveCommand}"
                      ToolTip="Remove this pass" AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}" />
            </Grid>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" Text="{Binding Caption}" />
            <ItemsControl ItemsSource="{Binding Keys}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Margin="0,10,20,0" Content="{Binding Field}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Problem}" Text="{Binding Problem}"
                       Visibility="{Binding Problem, Converter={StaticResource VisibleWhenText}}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="ComparisonRow">
        <StackPanel Margin="0,0,0,8">
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="290" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BlockHeading}" Text="{Binding Field}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding Columns}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Kinds}" DisplayMemberPath="Label"
                      SelectedValuePath="Kind" SelectedValue="{Binding Kind}"
                      AutomationProperties.Name="{Binding Field, StringFormat='How {0} is compared'}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <TextBox Width="90" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding UsesAmount, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Amount" />
              <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,12,0" VerticalAlignment="Center" Text="amount"
                         Visibility="{Binding UsesAmount, Converter={StaticResource VisibleWhenTrue}}" />
              <TextBox Width="70" Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding UsesPercentage, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Percentage" />
              <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,12,0" VerticalAlignment="Center" Text="%"
                         Visibility="{Binding UsesPercentage, Converter={StaticResource VisibleWhenTrue}}" />
              <TextBox Width="70" Text="{Binding DaysText, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding UsesDays, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Days" />
              <TextBlock Style="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center" Text="days"
                         Visibility="{Binding UsesDays, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Problem}" Text="{Binding Problem}"
                     Visibility="{Binding Problem, Converter={StaticResource VisibleWhenText}}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,20,24,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource TitleText}" Text="Reconcile datasets" />
        <Border Style="{StaticResource Pill}">
          <TextBlock FontSize="12" Text="Preview" />
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource SecondaryText}" Text="RecDiffy.NET · Excel add-in" />
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.Name="Reconciliation">
      <TabItem Header="Sources">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentControl Content="{Binding Sources.Left}" ContentTemplate="{StaticResource SidePanel}" Focusable="False" />
              <ContentControl Grid.Column="2" Content="{Binding Sources.Right}" ContentTemplate="{StaticResource SidePanel}" Focusable="False" />
            </Grid>
            <Border Style="{StaticResource Notice}">
              <TextBlock Style="{StaticResource SecondaryText}"
                         Text="Excel file opens a closed workbook read-only. Open workbook uses one that's already open, including changes not yet saved. Either way, select the data in Excel, including its header row. Rows with no values are left out." />
            </Border>
            <Expander Margin="0,16,0,0" IsExpanded="True">
              <Expander.Header>
                <TextBlock Style="{StaticResource SectionHeading}" Margin="0" Text="Preview sample rows" />
              </Expander.Header>
              <StackPanel>
                <ContentControl Content="{Binding Sources.Left}" ContentTemplate="{StaticResource PreviewPanel}" Focusable="False" />
                <ContentControl Content="{Binding Sources.Right}" ContentTemplate="{StaticResource PreviewPanel}" Focusable="False" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Rules">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel DataContext="{Binding Rules}">
            <TextBlock Style="{StaticResource SectionHeading}" Text="Match records, then compare values" />
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12" Visibility="{Binding NotEditable, Converter={StaticResource VisibleWhenText}}">
              <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding NotEditable}" />
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BlockHeading}" Text="Fields" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Pair same-named columns" Command="{Binding PairSameNamedColumnsCommand}" Margin="0,0,8,0"
                        ToolTip="Adds a field for each left and right column with the same name. You can change or remove any of them." />
                <Button Content="Add field" Command="{Binding AddFieldCommand}" Margin="0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,10"
                       Text="Pair a left column with a right column and say what it holds. Keys match records, compared fields are checked once records match, and carried fields come along unchanged." />
            <Grid Visibility="{Binding HasFields, Converter={StaticResource VisibleWhenTrue}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource ColumnLabel}" Text="Field" />
              <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="Left column" />
              <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="Right column" />
              <TextBlock Grid.Column="3" Style="{StaticResource ColumnLabel}" Text="Type" />
              <TextBlock Grid.Column="4" Style="{StaticResource ColumnLabel}" Text="Role" />
              <TextBlock Grid.Column="5" Style="{StaticResource ColumnLabel}" Text="Decimal places or date formats" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="No fields yet."
                       Visibility="{Binding HasFields, Converter={StaticResource VisibleWhenFalse}}" />

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource BlockHeading}" Text="Matching passes" />
              <Button Grid.Column="1" Content="Add pass" Command="{Binding AddPassCommand}" Margin="0" />
            </Grid>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,10"
                       Text="Passes run in order. Duplicate keys are never settled by picking a row: those records show as ambiguous." />
            <ItemsControl ItemsSource="{Binding Passes}" ItemTemplate="{StaticResource PassRow}" Focusable="False" />

            <TextBlock Style="{StaticResource BlockHeading}" Margin="0,20,0,0" Text="Comparisons" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,10"
                       Text="Compared fields are checked once records match. Numbers are rounded to their decimal places first, and a tolerance includes its bound. Keys must be equal." />
            <ItemsControl ItemsSource="{Binding Comparisons}" ItemTemplate="{StaticResource ComparisonRow}" Focusable="False" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="No compared fields yet. Set a field's role to Compared."
                       Visibility="{Binding HasComparisons, Converter={StaticResource VisibleWhenFalse}}" />

            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Problems}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Problem}" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Notice}" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource SecondaryText}"
                         Text="Advanced rules aren't editable here yet: normalizing values beyond reading columns, consolidation, routing, grouped matching and search limits." />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Results">
        <Grid DataContext="{Binding Results}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12" Visibility="{Binding ShowsEmptyNotice, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Style="{StaticResource SecondaryText}" Text="Choose your sources and rules, then run the reconciliation." />
            </Border>
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12" Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource BlockHeading}" HorizontalAlignment="Left" Text="{Binding Stage, StringFormat='{}{0}…'}"
                             AutomationProperties.LiveSetting="Polite" />
                  <ProgressBar Height="6" Margin="0,8,24,0" Minimum="0" Maximum="1" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                               Value="{Binding ProgressValue, Mode=OneWay}" Foreground="{StaticResource InkBrush}" Background="{StaticResource PaperBrush}"
                               BorderThickness="0" AutomationProperties.Name="Run progress" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Margin="0"
                        Command="{Binding DataContext.RunCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}">
              <TextBlock Style="{StaticResource Problem}" Margin="0" TextWrapping="Wrap" Text="{Binding Message}" />
            </Border>
            <Border Style="{StaticResource Notice}" Margin="0,0,0,12"
                    Visibility="{Binding DataContext.ShowsStaleNotice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                         Text="The rules or sources changed after this run. Run again to refresh the results." />
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="1" Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Run.Label}" />
            <ItemsControl ItemsSource="{Binding Run.Counts}" Margin="0,8,0,8" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,28,4">
                    <TextBlock x:Name="Count" FontSize="22" Foreground="{StaticResource TextBrush}" Text="{Binding Count, StringFormat='{}{0:N0}'}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                      <Setter TargetName="Count" Property="Foreground" Value="{StaticResource BreakBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <DataGrid Grid.Row="2" ItemsSource="{Binding Run.Rows}" SelectedItem="{Binding Selected}"
                    VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Results">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Outcome" Width="190" Binding="{Binding Outcome, Mode=OneTime}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource PreviewCellText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBreak, Mode=OneTime}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BreakBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Left" Width="*" Binding="{Binding Left, Mode=OneTime}" ElementStyle="{StaticResource PreviewCellText}" />
              <DataGridTextColumn Header="Right" Width="*" Binding="{Binding Right, Mode=OneTime}" ElementStyle="{StaticResource PreviewCellText}" />
              <DataGridTextColumn Header="Details" Width="2*" Binding="{Binding Details, Mode=OneTime}" ElementStyle="{StaticResource PreviewCellText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Expander Grid.Row="3" Margin="0,12,0,0" Header="Rows RecDiffy couldn't read"
                    Visibility="{Binding Run.HasRowProblems, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl ItemsSource="{Binding Run.RowProblems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>

          <Expander Grid.Row="4" Margin="0,12,0,0" Header="Explain selected result" IsExpanded="{Binding IsExplanationOpen}"
                    Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel>
                <TextBlock Style="{StaticResource SecondaryText}" Text="Select a result to see how RecDiffy reached it."
                           Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenFalse}}" />
                <ItemsControl ItemsSource="{Binding Explanation}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource BlockHeading}" HorizontalAlignment="Left" Text="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding Run.Identity}" />
              </StackPanel>
            </ScrollViewer>
          </Expander>
        </Grid>
      </TabItem>
      <TabItem Header="Settings">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Settings aren't available yet." />
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding Status}"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Review rules →" Command="{Binding ReviewRulesCommand}"
                  Visibility="{Binding ShowsReviewRules, Converter={StaticResource VisibleWhenTrue}}" />
          <Button Style="{StaticResource PrimaryButton}" Content="Run reconciliation" Command="{Binding RunCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="{StaticResource VeilBrush}"
          Visibility="{Binding Sources.IsReading, Converter={StaticResource VisibleWhenTrue}}">
      <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
              Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Sources.ReadingMessage}" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Sources.ReadingProgress, Mode=OneWay}"
                       Foreground="{StaticResource InkBrush}" Background="{StaticResource SoftBrush}" BorderThickness="0" />
          <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                     Text="Don't change the workbook until reading finishes. Excel is busy until then." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
