<Window x:Class="RecDiffy.ExcelAddIn.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecDiffy · Reconcile datasets"
        Width="920" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource TextBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RecDiffy.ExcelAddIn;component/Themes/Shell.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,20,24,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource TitleText}" Text="Reconcile datasets" />
        <Border Style="{StaticResource Pill}">
          <TextBlock FontSize="12" Text="Preview" />
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource SecondaryText}" Text="RecDiffy.NET · Excel add-in" />
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.Name="Reconciliation">
      <TabItem Header="Sources">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Sources.LeftHeading}" />
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=LeftAlias}" Content="_Left alias (optional)" />
              <TextBox x:Name="LeftAlias" Text="{Binding Sources.LeftAlias, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Left alias" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Sources.RightHeading}" />
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=RightAlias}" Content="R_ight alias (optional)" />
              <TextBox x:Name="RightAlias" Text="{Binding Sources.RightAlias, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Right alias" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Notice}">
            <TextBlock Style="{StaticResource SecondaryText}"
                       Text="Selecting the left and right data comes in the next build. For now, you can name each side." />
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Rules">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Matching and comparison rules aren't available yet." />
        </Border>
      </TabItem>
      <TabItem Header="Results">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Choose your sources and rules, then run the reconciliation." />
        </Border>
      </TabItem>
      <TabItem Header="Settings">
        <Border Style="{StaticResource Notice}" VerticalAlignment="Top" Margin="0">
          <TextBlock Style="{StaticResource SecondaryText}" Text="Settings aren't available yet." />
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding Status}"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Review rules →" Command="{Binding ReviewRulesCommand}"
                  Visibility="{Binding ShowsReviewRules, Converter={StaticResource VisibleWhenTrue}}" />
          <Button Style="{StaticResource PrimaryButton}" Content="Run reconciliation" IsEnabled="{Binding CanRun}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
