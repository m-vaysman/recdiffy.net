{
  "formatVersion": 1, "profileId": "p06", "version": "1.0.0",
  "sources": { "left": { "culture": "en-US" }, "right": { "culture": "de-DE" } },
  "fields": [
    { "name": "TradeRef", "type": "Symbol", "role": "Identity" },
    { "name": "Isin", "type": "Symbol", "role": "Key" },
    { "name": "Side", "type": "Symbol", "role": "Key" },
    { "name": "Quantity", "type": "Decimal", "role": "Key", "scale": 0 },
    { "name": "Price", "type": "Decimal", "role": "Key", "scale": 4 },
    { "name": "TradeDate", "type": "Date", "role": "Key" },
    { "name": "NetAmount", "type": "Decimal", "role": "Economic", "scale": 2 }
  ],
  "normalization": {
    "left": {
      "identify": [
        { "rule": "text.regex", "from": "Our Ref", "to": "TradeRef", "pattern": "^TR-([0-9]+)$", "replacement": "$1" },
        { "rule": "symbol.map", "from": "ISIN", "to": "Isin" },
        { "rule": "symbol.map", "from": "Side", "to": "Side" }
      ],
      "parse": [
        { "rule": "decimal.parse", "from": "Qty", "to": "Quantity" },
        { "rule": "decimal.parse", "from": "Price", "to": "Price" },
        { "rule": "decimal.parse", "from": "Net", "to": "NetAmount" },
        { "rule": "date.parse", "from": "Trade Date", "to": "TradeDate", "formats": ["dd MMM yyyy"] }
      ]
    },
    "right": {
      "identify": [
        { "rule": "symbol.map", "from": "Cpty Ref", "to": "TradeRef" },
        { "rule": "symbol.map", "from": "Security", "to": "Isin" },
        { "rule": "symbol.map", "from": "Action", "to": "Side", "map": { "B": "BUY", "S": "SELL" } }
      ],
      "parse": [
        { "rule": "decimal.parse", "from": "Size", "to": "Quantity" },
        { "rule": "decimal.parse", "from": "Px", "to": "Price" },
        { "rule": "decimal.parse", "from": "Proceeds", "to": "NetAmount" },
        { "rule": "date.parse", "from": "Trade Dt", "to": "TradeDate", "formats": ["yyyy.MM.dd"] }
      ]
    }
  },
  "paths": [
    {
      "id": "all", "route": { "rule": "route.all" },
      "passes": [
        { "id": "ref", "pass": "match.sharedRef", "key": ["TradeRef"] },
        { "id": "natural", "pass": "match.naturalKey", "key": ["Isin", "Side", "Quantity", "Price", "TradeDate"] }
      ]
    }
  ]
}
