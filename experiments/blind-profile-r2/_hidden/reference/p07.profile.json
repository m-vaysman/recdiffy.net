        { "rule": "symbol.map", "from": "Product", "to": "Product" },
        { "rule": "symbol.map", "from": "Pkg Link", "to": "PkgLink" },
        { "rule": "symbol.map", "from": "Leg", "to": "Leg", "map": { "P": "PAY", "R": "REC" } }
      ],
      "parse": [
        { "rule": "decimal.parse", "from": "Notional", "to": "Notional" },
