    { "name": "Notional", "type": "Decimal", "role": "Economic", "scale": 0 },
    { "name": "Net", "type": "Decimal", "role": "Economic", "scale": 2 },
    { "name": "Maturity", "type": "Date", "role": "Economic" },
    { "name": "PkgLink", "type": "Symbol", "role": "Package" },
